.container {
  padding: 24rpx;
  min-height: 100vh;
}

.detail-card {
  padding: 32rpx;
}

.student-section {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.large-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4CAF50, #81c784);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 52rpx;
  font-weight: 600;
  margin-right: 24rpx;
}

.student-detail {
  display: flex;
  flex-direction: column;
}

.student-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.attendance-date {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}

.divider {
  height: 16rpx;
  background: #f5f5f5;
  margin: 24rpx 0;
  border-radius: 8rpx;
}

.info-section {
  margin-bottom: 32rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
}

.info-label {
  font-size: 28rpx;
  color: #999;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.remark-text {
  color: #666;
  font-weight: 400;
}

.status-badge {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.status-present {
  background: rgba(76, 175, 80, 0.1);
  color: #4CAF50;
}

.status-absent {
  background: rgba(244, 67, 54, 0.1);
  color: #f44336;
}

.status-late {
  background: rgba(255, 152, 0, 0.1);
  color: #ff9800;
}

.status-leave {
  background: rgba(33, 150, 243, 0.1);
  color: #2196F3;
}

.action-section {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  padding: 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  border: none;
}

.edit-btn {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
}

.delete-btn {
  background: #f8f9fa;
  color: #f44336;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 32rpx;
}

.back-btn {
  background: linear-gradient(135deg, #4CAF50, #45a049);
  color: #fff;
  padding: 20rpx 48rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  border: none;
}