<view class="container">
  <view class="header">
    <view class="date-section">
      <text class="date-text">{{currentDate}}</text>
      <text class="week-text">{{weekDay}}</text>
    </view>
    <view class="stats-row">
      <view class="stat-item">
        <text class="stat-value present">{{stats.present}}</text>
        <text class="stat-label">出勤</text>
      </view>
      <view class="stat-item">
        <text class="stat-value absent">{{stats.absent}}</text>
        <text class="stat-label">缺勤</text>
      </view>
      <view class="stat-item">
        <text class="stat-value late">{{stats.late}}</text>
        <text class="stat-label">迟到</text>
      </view>
      <view class="stat-item">
        <text class="stat-value leave">{{stats.leave}}</text>
        <text class="stat-label">请假</text>
      </view>
    </view>
  </view>

  <view class="add-btn-wrap">
    <button class="add-btn" bindtap="goAddAttendance">
      <text class="add-icon">+</text>
      <text>添加考勤</text>
    </button>
  </view>

  <view class="section-title">
    <text>今日考勤记录</text>
    <text class="record-count">{{attendances.length}}条记录</text>
  </view>

  <view class="attendance-list">
    <view 
      wx:for="{{attendances}}" 
      wx:key="id" 
      class="attendance-item card"
      bindtap="goDetail"
      data-id="{{item.id}}"
    >
      <view class="item-left">
        <view class="avatar">
          <text>{{item.studentName.charAt(0)}}</text>
        </view>
        <view class="info">
          <text class="student-name">{{item.studentName}}</text>
          <text class="record-date">{{item.date}}</text>
        </view>
      </view>
      <view class="item-right">
        <text class="status {{'status-' + item.status}}">{{getStatusText(item.status)}}</text>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>

  <view wx:if="{{attendances.length === 0}}" class="empty-state">
    <text class="empty-icon">📋</text>
    <text class="empty-text">暂无考勤记录</text>
    <text class="empty-hint">点击上方按钮添加考勤</text>
  </view>
</view>