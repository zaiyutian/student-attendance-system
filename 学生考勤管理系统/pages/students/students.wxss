.container {
  padding: 24rpx;
  padding-bottom: 180rpx;
}

.search-bar {
  margin-bottom: 24rpx;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 40rpx;
  padding: 0 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  height: 80rpx;
  font-size: 28rpx;
}

.class-filter {
  margin-bottom: 20rpx;
}

.class-scroll {
  white-space: nowrap;
}

.class-list {
  display: inline-flex;
  padding: 8rpx 0;
}

.class-item {
  display: inline-block;
  padding: 16rpx 32rpx;
  background: #fff;
  border-radius: 32rpx;
  margin-right: 16rpx;
  font-size: 26rpx;
  color: #666;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.class-item.active {
  background: linear-gradient(135deg, #4CAF50, #45a049);
  color: #fff;
}

.student-count {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.student-list {
  margin-top: 8rpx;
}

.student-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.avatar-wrap {
  margin-right: 20rpx;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea, #764ba2);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
}

.student-info {
  flex: 1;
}

.student-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: block;
}

.student-detail {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
}

.action-btns {
  display: flex;
}

.action-btn {
  padding: 16rpx 32rpx;
  background: linear-gradient(135deg, #4CAF50, #45a049);
  color: #fff;
  border-radius: 24rpx;
  font-size: 24rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #666;
}