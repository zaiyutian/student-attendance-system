page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
}

.container {
  padding: 20rpx;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.btn-primary {
  background: linear-gradient(135deg, #4CAF50, #45a049);
  color: #ffffff;
  border: none;
  border-radius: 40rpx;
  padding: 24rpx 48rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.btn-secondary {
  background: #f0f0f0;
  color: #666666;
  border: none;
  border-radius: 40rpx;
  padding: 20rpx 32rpx;
  font-size: 26rpx;
}

.text-primary {
  color: #4CAF50;
}

.text-danger {
  color: #f44336;
}

.text-warning {
  color: #ff9800;
}

.text-info {
  color: #2196F3;
}

.status-present {
  color: #4CAF50;
  background: rgba(76, 175, 80, 0.1);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.status-absent {
  color: #f44336;
  background: rgba(244, 67, 54, 0.1);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.status-late {
  color: #ff9800;
  background: rgba(255, 152, 0, 0.1);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.status-leave {
  color: #2196F3;
  background: rgba(33, 150, 243, 0.1);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}